{
  "name": "webot-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Backend and dashboard service baseline for WeBot API monetization.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "vitest run tests/health.test.ts",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:rls": "npm run db:check",
    "test:webhooks": "vitest run tests/api/stripe-webhook-signature.test.ts",
    "test:rate-limit": "vitest run tests/api/rate-limit-concurrency.test.ts",
    "stripe:create-tiers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/stripe/create-subscription-tiers.ts",
    "stripe:validate-tiers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/stripe/validate-subscription-tiers.ts",
    "stripe:readback-ui-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-stripe-readback-ui.ts",
    "db:migrate": "supabase migration up",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-db-contract.ts",
    "runtime:local-supabase-proof": "tsx scripts/verify-local-supabase-runtime.ts",
    "runtime:remote-supabase-proof": "tsx scripts/verify-remote-supabase-runtime.ts",
    "release:agent-api-proof": "tsx scripts/verify-agent-api-proof.ts",
    "release:fulfillment-proof": "tsx scripts/verify-fulfillment-proof.ts",
    "release:payment-webhook-proof": "tsx scripts/verify-payment-webhook-proof.ts",
    "secrets:check": "node scripts/secrets-check.mjs",
    "env:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-deploy-env.ts",
    "env:check:staging": "npm run env:check -- --target staging",
    "env:check:production": "npm run env:check -- --target production",
    "release:readiness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-release-readiness.ts",
    "release:resource-discovery": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/discover-resource-sources.ts",
    "release:resource-inventory": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-resource-inventory.ts",
    "release:owned-runtime-plan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/prepare-owned-runtime-plan.ts",
    "runtime:model-selection": "tsx scripts/verify-model-runtime-selection.ts",
    "runtime:family-proof": "tsx scripts/run-family-fulfillment-proof.ts",
    "release:owned-resource-auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-owned-resource-auth.ts",
    "release:env-prep": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/prepare-release-env.ts",
    "release:domains": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-release-domains.ts",
    "release:cwatchtower-snapshot": "bash scripts/capture-cwatchtower-staging-isolation-snapshot.sh",
    "release:staging-isolation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-cwatchtower-staging-isolation.ts",
    "release:staging-cwatchtower": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/run-cwatchtower-staging-release.ts",
    "release:production-cwatchtower": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/run-cwatchtower-production-release.ts",
    "release:approval-packet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/prepare-owned-launch-approval.ts",
    "release:inputs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-release-inputs.ts",
    "release:proof": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-release-proof.ts",
    "release:remote-smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-remote-release-smoke.ts",
    "release:rotate-smoke-password": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/rotate-production-smoke-password.ts",
    "release:backup-production-db": "bash scripts/backup-cwatchtower-production-db.sh",
    "release:migrate-0022": "bash scripts/deploy-cwatchtower-migration-0022.sh",
    "release:completion-audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-completion-audit.ts",
    "release:final": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/verify-final-release.ts",
    "release:safe-evidence": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/refresh-final-release-evidence.ts",
    "proof:migration-0022-upgrade": "bash scripts/proof/run-0022-upgrade-rehearsal.sh",
    "files:cleanup": "node scripts/cleanup-expired-files.mjs",
    "ux:test": "tsx scripts/ux/run-ux-browser-pass.ts",
    "ux:test:local": "tsx scripts/ux/run-isolated-local-ux-pass.ts --output-dir proof-results/ux-redesign/local-pass",
    "ux:test:production": "tsx scripts/ux/run-ux-browser-pass.ts --base-url https://app.webot.studio --auth credentials --env-file .env.production.local --output-dir proof-results/ux-redesign/production-pass",
    "ux:acceptance:live-attachments": "tsx scripts/ux/run-live-attachment-acceptance.ts",
    "ux:acceptance:live-attachment-matrix": "tsx scripts/ux/run-live-attachment-matrix.ts",
    "ux:acceptance:local-attachment-matrix": "tsx scripts/ux/run-local-attachment-matrix.ts",
    "ux:publish": "tsx scripts/ux/run-ux-publish.ts",
    "ops:fulfillment-transition": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/ops/fulfillment-transition.ts",
    "ops:qa-review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/ops/qa-review.ts",
    "ops:dispatch-live-jobs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/ops/dispatch-live-jobs.ts",
    "ops:register-local-deliverable": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/ops/register-local-deliverable.ts",
    "ops:sync-comfyui-workflows": "bash scripts/ops/sync-comfyui-workflows.sh",
    "ops:resource-watchdog": "tsx scripts/ops/resource-watchdog.ts",
    "ops:start-after-login": "bash scripts/ops/start-heavy-runtimes-after-login.sh",
    "ops:worker-packet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/ops/worker-station-packet.ts",
    "daemon:fulfillment": "tsx scripts/daemon/fulfillment-daemon.ts",
    "heal:clear-gpu-lock": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heal/clear-gpu-lock.ts",
    "heal:restart-ollama": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heal/restart-ollama.ts",
    "heal:reset-comfy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heal/reset-comfy.ts",
    "heal:recover-comfy-job": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heal/recover-comfy-job.ts",
    "heal:recover-comfy-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heal/recover-comfy-api-unresponsive.ts",
    "heal:rerun-job": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heal/rerun-job.ts",
    "heartbeat:engineer-report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heartbeat/engineer-report.ts",
    "heartbeat:consumer-proof": "node --env-file-if-exists=.env.fulfillment.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heartbeat/run-consumer-proof.ts",
    "heartbeat:consumer-decision": "node --env-file-if-exists=.env.fulfillment.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heartbeat/run-consumer-decision.ts",
    "heartbeat:proposal-schedule": "node --env-file-if-exists=.env.fulfillment.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types -- scripts/heartbeat/run-proposal-schedule.ts",
    "ops:publish-proposal-mode": "bash scripts/ops/publish-proposal-mode.sh",
    "deploy:check": "npm run secrets:check && npm run env:check -- --target local && npm run db:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run ux:test:local && npm run files:cleanup -- --dry-run && npm run build && npm run release:agent-api-proof -- --report-file test-results/final-release/local-agent-api-proof.json && npm run release:fulfillment-proof -- --report-file test-results/final-release/local-fulfillment-proof.json && npm run release:payment-webhook-proof -- --report-file test-results/final-release/local-payment-webhook-proof.json"
  },
  "dependencies": {
    "file-type": "22.0.1",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
